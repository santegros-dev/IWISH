# Подключение к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iwish

# Адрес сайта (для ссылок в письмах и превью)
APP_URL=http://localhost:3000

# Вход через Telegram: токен и имя бота из @BotFather (необязательно)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# Отправка писем с кодом входа. Пусто = код пишется в лог сервера (для разработки)
SMTP_URL=
MAIL_FROM="IWISH <no-reply@example.com>"
